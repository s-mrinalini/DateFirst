# DateFirst backend env template. Copy to .env and fill in.

# --- Required ---------------------------------------------------------------
ENV=development                     # development | staging | production
APP_URL=http://localhost:3000       # public URL of the SPA (used in reset emails)

MONGO_URL=mongodb://localhost:27017
DB_NAME=datefirst

# 32+ char random secret. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production, server REFUSES to start if this is missing or weak.
JWT_SECRET=

# Comma-separated list. Wildcards are NOT allowed in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (SendGrid) — leave blank to use mock that logs to stdout ---------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@datefirst.app

# --- SMS (Twilio) — leave blank to use mock --------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- File storage (AWS S3) — leave blank to use local /app/uploads ---------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1
UPLOAD_DIR=/app/uploads

# --- CSAM scanning ---------------------------------------------------------
# Required in production. 'none' is dev-only and logs a warning per upload.
# Options: hive | thorn | photodna | none
CSAM_PROVIDER=none
HIVE_API_KEY=
# THORN_API_KEY=
# PHOTODNA_KEY=
CSAM_HIVE_THRESHOLD=0.7
